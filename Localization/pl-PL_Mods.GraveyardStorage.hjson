Common: {
	GravestoneName: Nagrobek
	ItemsStoredMessage: Przechowywane przedmioty: {0}
}

UI: {
	GetItemsButton: Zabierz przedmioty
	GetItemsHover: Przywróć wszystkie przedmioty do ich oryginalnych miejsc w ekwipunku
	ItemCount: Przechowywane przedmioty: {0}
}

Configs: {
	GraveyardStorageServerConfig: {
		DisplayName: Ustawienia serwera Graveyard Storage
		Headers.GravestoneSafety: Ustawienia bezpieczeństwa nagrobka

		GuaranteeGravestonePlacement: {
			Label: Gwarantuj postawienie nagrobka
			Tooltip:
				'''
				Po włączeniu nagrobek na pewno przetrwa.
				Mod umieszcza pod nim tymczasową kamienną podłogę, aby zawsze miał na czym stać,
				wynosi go z każdej cieczy i (jeśli nadal jest w cieczy) otacza go tymczasowymi blokami bąbelkowymi.
				Wszystkie tymczasowe bloki są usuwane, gdy odbierzesz przedmioty lub nagrobek zostanie zniszczony.
				Przydatne przy śmierci w lawie lub w jej pobliżu. Domyślnie wyłączone.
				'''
		}

		UseBubbleBlocksInLiquid: {
			Label: Używaj bloków bąbelkowych w cieczy
			Tooltip:
				'''
				Przy gwarantowanym postawieniu odgrodź tymczasowymi blokami bąbelkowymi każdą ciecz wciąż dotykającą nagrobka.
				Bloki bąbelkowe powstrzymują lawę i wodę, a Ty nadal możesz przez nie przechodzić.
				Wyłącz to, jeśli chcesz tylko kamienną podłogę i przenoszenie.
				'''
		}
	}

	GraveyardStorageConfig: {
		DisplayName: Ustawienia Graveyard Storage
		Headers.ItemRestoration: Ustawienia przywracania przedmiotów

		PlacementMode: {
			Label: Tryb umieszczania przedmiotów
			Tooltip:
				'''
				Kontroluje sposób umieszczania przedmiotów w ekwipunku podczas przywracania z nagrobka.
				To ustawienie dotyczy tylko sytuacji, gdy odbierasz własne przedmioty.
				Gdy inny gracz zabiera twoje przedmioty, zawsze używany jest tryb "Bez zamiany".
				'''
		}
	}

	ItemPlacementMode: {
		Tooltip: ""

		ReplaceStarred: {
			Label: Zamień ulubione przedmioty
			Tooltip: Tylko ulubione (oznaczone gwiazdką) przedmioty zastąpią przedmioty w ich oryginalnych miejscach. Inne przedmioty trafiają do pustych miejsc lub są upuszczane.
		}

		ReplaceAll: {
			Label: Zamień wszystkie przedmioty
			Tooltip: Wszystkie przedmioty będą próbowały zastąpić przedmioty w ich oryginalnych miejscach. Wyparte przedmioty są przenoszone do pustych miejsc lub upuszczane.
		}

		NoReplacement: {
			Label: Bez zamiany
			Tooltip: Przedmioty trafiają tylko do pustych miejsc lub są upuszczane. Żadne przedmioty nie zostaną wyparte z ich obecnych pozycji.
		}
	}
}
