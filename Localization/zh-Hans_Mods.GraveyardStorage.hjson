Common: {
	GravestoneName: 墓碑
	ItemsStoredMessage: 已存储物品：{0}
}

UI: {
	GetItemsButton: 获取物品
	GetItemsHover: 将所有物品恢复到其原始物品栏位置
	ItemCount: 已存储物品：{0}
}

Configs: {
	GraveyardStorageServerConfig: {
		DisplayName: Graveyard Storage 服务器设置
		Headers.GravestoneSafety: 墓碑安全设置

		GuaranteeGravestonePlacement: {
			Label: 保证墓碑放置
			Tooltip:
				'''
				启用后，墓碑必定会保留下来。
				模组会在其下方放置临时石块地板，让它始终有依托，
				将它抬升到液体之外，若仍在液体中，则用临时气泡块将其围住。
				当你取回物品或墓碑被摧毁后，所有临时方块都会被移除。
				在熔岩中或附近死亡时很有用。默认关闭。
				'''
		}

		UseBubbleBlocksInLiquid: {
			Label: 在液体中使用气泡块
			Tooltip:
				'''
				保证放置时，用临时气泡块将仍接触墓碑的液体隔开。
				气泡块能挡住熔岩和水，同时你仍可穿过它们。
				如果只想要石块地板和搬移功能，请关闭此项。
				'''
		}
	}

	GraveyardStorageConfig: {
		DisplayName: 墓地存储设置
		Headers.ItemRestoration: 物品恢复设置

		PlacementMode: {
			Label: 物品放置模式
			Tooltip:
				'''
				控制从墓碑恢复物品时如何将物品放入您的物品栏。
				此设置仅适用于您取回自己的物品时。
				当其他玩家拾取您的物品时，始终使用"不替换"模式。
				'''
		}
	}

	ItemPlacementMode: {
		Tooltip: ""

		ReplaceStarred: {
			Label: 替换收藏物品
			Tooltip: 只有收藏（标星）的物品会替换其原始槽位中的物品。其他物品将放入空槽位或掉落。
		}

		ReplaceAll: {
			Label: 替换所有物品
			Tooltip: 所有物品都会尝试替换其原始槽位中的物品。被替换的物品将移至空槽位或掉落。
		}

		NoReplacement: {
			Label: 不替换
			Tooltip: 物品只会放入空槽位或掉落。不会有任何物品从其当前位置被替换。
		}
	}
}
