Common: {
	GravestoneName: Lápide
	ItemsStoredMessage: Itens armazenados: {0}
}

UI: {
	GetItemsButton: Pegar itens
	GetItemsHover: Restaurar todos os itens para suas posições originais no inventário
	ItemCount: Itens armazenados: {0}
}

Configs: {
	GraveyardStorageServerConfig: {
		DisplayName: Configurações de servidor do Graveyard Storage
		Headers.GravestoneSafety: Configurações de segurança da lápide

		GuaranteeGravestonePlacement: {
			Label: Garantir a colocação da lápide
			Tooltip:
				'''
				Quando ativado, a lápide tem sobrevivência garantida.
				O mod coloca um piso de pedra temporário embaixo dela para que sempre tenha onde se apoiar,
				a eleva para fora de qualquer líquido e (se ainda estiver em um líquido) a cerca com blocos de bolha temporários.
				Todos os blocos temporários são removidos quando você recupera seus itens ou a lápide é destruída.
				Útil ao morrer na lava ou perto dela. Desativado por padrão.
				'''
		}

		UseBubbleBlocksInLiquid: {
			Label: Usar blocos de bolha em líquido
			Tooltip:
				'''
				Ao garantir a colocação, isole com blocos de bolha temporários qualquer líquido que ainda toque a lápide.
				Blocos de bolha mantêm a lava e a água do lado de fora enquanto você ainda pode atravessá-los.
				Desative isto se você quiser apenas o piso de pedra e a realocação.
				'''
		}
	}

	GraveyardStorageConfig: {
		DisplayName: Configurações do Graveyard Storage
		Headers.ItemRestoration: Configurações de restauração de itens

		PlacementMode: {
			Label: Modo de colocação de itens
			Tooltip:
				'''
				Controla como os itens são colocados no seu inventário quando restaurados de uma lápide.
				Esta configuração só se aplica quando você recupera seus próprios itens.
				Quando outro jogador pega seus itens, "Sem substituição" é sempre usado.
				'''
		}
	}

	ItemPlacementMode: {
		Tooltip: ""

		ReplaceStarred: {
			Label: Substituir itens favoritos
			Tooltip: Apenas itens favoritos (com estrela) substituirão itens em seus slots originais. Outros itens vão para slots vazios ou são dropados.
		}

		ReplaceAll: {
			Label: Substituir todos os itens
			Tooltip: Todos os itens tentarão substituir itens em seus slots originais. Itens deslocados são movidos para slots vazios ou dropados.
		}

		NoReplacement: {
			Label: Sem substituição
			Tooltip: Itens só vão para slots vazios ou são dropados. Nenhum item será deslocado de suas posições atuais.
		}
	}
}
