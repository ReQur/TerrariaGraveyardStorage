Common: {
	GravestoneName: Надгробие
	ItemsStoredMessage: Сохранённые предметы: {0}
}

UI: {
	GetItemsButton: Забрать предметы
	GetItemsHover: Восстановить все предметы в их исходные слоты инвентаря
	ItemCount: Сохранённые предметы: {0}
}

Configs: {
	GraveyardStorageServerConfig: {
		DisplayName: Настройки сервера Graveyard Storage
		Headers.GravestoneSafety: Настройки сохранности надгробия

		GuaranteeGravestonePlacement: {
			Label: Гарантировать установку надгробия
			Tooltip:
				'''
				Когда включено, надгробие гарантированно уцелеет.
				Мод ставит под ним временный каменный пол, чтобы ему всегда было на чём стоять,
				поднимает его из любой жидкости и (если оно всё ещё в жидкости) окружает временными пузырьковыми блоками.
				Все временные блоки убираются, как только вы заберёте предметы или надгробие будет разрушено.
				Полезно при смерти в лаве или рядом с ней. По умолчанию выключено.
				'''
		}

		UseBubbleBlocksInLiquid: {
			Label: Использовать пузырьковые блоки в жидкости
			Tooltip:
				'''
				При гарантированной установке отгораживать временными пузырьковыми блоками любую жидкость, всё ещё касающуюся надгробия.
				Пузырьковые блоки не пускают лаву и воду, но сквозь них можно проходить.
				Отключите, если нужен только каменный пол и перенос.
				'''
		}
	}

	GraveyardStorageConfig: {
		DisplayName: Настройки Graveyard Storage
		Headers.ItemRestoration: Настройки восстановления предметов

		PlacementMode: {
			Label: Режим размещения предметов
			Tooltip:
				'''
				Определяет, как предметы размещаются в инвентаре при восстановлении из надгробия.
				Эта настройка применяется только когда вы забираете свои собственные предметы.
				Когда другой игрок забирает ваши предметы, всегда используется режим "Без замены".
				'''
		}
	}

	ItemPlacementMode: {
		Tooltip: ""

		ReplaceStarred: {
			Label: Заменять избранные предметы
			Tooltip: Только избранные (отмеченные звёздочкой) предметы будут заменять предметы в своих исходных слотах. Остальные предметы помещаются в пустые слоты или выпадают.
		}

		ReplaceAll: {
			Label: Заменять все предметы
			Tooltip: Все предметы будут пытаться заменить предметы в своих исходных слотах. Вытесненные предметы перемещаются в пустые слоты или выпадают.
		}

		NoReplacement: {
			Label: Без замены
			Tooltip: Предметы помещаются только в пустые слоты или выпадают. Никакие предметы не будут вытеснены из своих текущих позиций.
		}
	}
}
