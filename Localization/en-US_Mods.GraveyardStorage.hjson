Common: {
	GravestoneName: Gravestone
	ItemsStoredMessage: Items stored: {0}
}

UI: {
	GetItemsButton: Get Items
	GetItemsHover: Restore all items to their original inventory slots
	ItemCount: Stored items: {0}
}

Configs: {
	GraveyardStorageServerConfig: {
		DisplayName: Graveyard Storage Server Settings
		Headers.GravestoneSafety: Gravestone Safety Settings

		GuaranteeGravestonePlacement: {
			Label: Guarantee Gravestone Placement
			Tooltip:
				'''
				When enabled, the gravestone is guaranteed to survive.
				The mod places a temporary stone floor under it so it always has something to sit on,
				moves it up out of any liquid, and (if still in a liquid) surrounds it with temporary bubble blocks.
				All temporary blocks are removed once you retrieve your items or the gravestone is destroyed.
				Useful when dying in or near lava. Off by default.
				'''
		}

		UseBubbleBlocksInLiquid: {
			Label: Use Bubble Blocks In Liquid
			Tooltip:
				'''
				When guaranteeing placement, wall off any liquid still touching the gravestone with temporary bubble blocks.
				Bubble blocks keep lava and water out while you can still walk through them.
				Disable this if you only want the stone floor and relocation behavior.
				'''
		}
	}

	GraveyardStorageConfig: {
		DisplayName: Graveyard Storage Settings
		Headers.ItemRestoration: Item Restoration Settings

		PlacementMode: {
			Label: Item Placement Mode
			Tooltip:
				'''
				Controls how items are placed in your inventory when restored from a tombstone.
				This setting only applies when you retrieve your own items.
				When another player picks up your items, "No Replacement" is always used.
				'''
		}
	}

	ItemPlacementMode: {
		Tooltip: ""

		ReplaceStarred: {
			Label: Replace Starred Items
			Tooltip: Only favorited (starred) items will replace items in their original slots. Other items go to empty slots or are dropped.
		}

		ReplaceAll: {
			Label: Replace All Items
			Tooltip: All items will try to replace items in their original slots. Displaced items are moved to empty slots or dropped.
		}

		NoReplacement: {
			Label: No Replacement
			Tooltip: Items only go to empty slots or are dropped. No items will be displaced from their current positions.
		}
	}
}
