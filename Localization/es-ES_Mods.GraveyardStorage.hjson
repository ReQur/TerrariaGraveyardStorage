Common: {
	GravestoneName: Lápida
	ItemsStoredMessage: Objetos almacenados: {0}
}

UI: {
	GetItemsButton: Obtener objetos
	GetItemsHover: Restaurar todos los objetos a sus posiciones originales del inventario
	ItemCount: Objetos almacenados: {0}
}

Configs: {
	GraveyardStorageServerConfig: {
		DisplayName: Ajustes de servidor de Graveyard Storage
		Headers.GravestoneSafety: Ajustes de seguridad de la lápida

		GuaranteeGravestonePlacement: {
			Label: Garantizar la colocación de la lápida
			Tooltip:
				'''
				Cuando está activado, se garantiza que la lápida sobreviva.
				El mod coloca un suelo de piedra temporal debajo para que siempre tenga dónde apoyarse,
				la sube para sacarla de cualquier líquido y (si sigue en un líquido) la rodea con bloques de burbuja temporales.
				Todos los bloques temporales se eliminan cuando recuperas tus objetos o la lápida es destruida.
				Útil cuando mueres en la lava o cerca de ella. Desactivado por defecto.
				'''
		}

		UseBubbleBlocksInLiquid: {
			Label: Usar bloques de burbuja en líquido
			Tooltip:
				'''
				Al garantizar la colocación, aísla con bloques de burbuja temporales cualquier líquido que aún toque la lápida.
				Los bloques de burbuja mantienen fuera la lava y el agua mientras puedes atravesarlos.
				Desactívalo si solo quieres el suelo de piedra y el reubicado.
				'''
		}
	}

	GraveyardStorageConfig: {
		DisplayName: Configuración de Graveyard Storage
		Headers.ItemRestoration: Configuración de restauración de objetos

		PlacementMode: {
			Label: Modo de colocación de objetos
			Tooltip:
				'''
				Controla cómo se colocan los objetos en tu inventario cuando se restauran desde una lápida.
				Esta configuración solo se aplica cuando recuperas tus propios objetos.
				Cuando otro jugador recoge tus objetos, siempre se usa "Sin reemplazo".
				'''
		}
	}

	ItemPlacementMode: {
		Tooltip: ""

		ReplaceStarred: {
			Label: Reemplazar objetos favoritos
			Tooltip: Solo los objetos favoritos (con estrella) reemplazarán objetos en sus ranuras originales. Otros objetos van a ranuras vacías o se dejan caer.
		}

		ReplaceAll: {
			Label: Reemplazar todos los objetos
			Tooltip: Todos los objetos intentarán reemplazar objetos en sus ranuras originales. Los objetos desplazados se mueven a ranuras vacías o se dejan caer.
		}

		NoReplacement: {
			Label: Sin reemplazo
			Tooltip: Los objetos solo van a ranuras vacías o se dejan caer. Ningún objeto será desplazado de sus posiciones actuales.
		}
	}
}
